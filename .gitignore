# Python
# English: Exclude Python compiled files and caches
# Deutsch: Schließe Python-Kompilate und Caches aus
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual Environment
# English: Exclude virtual environment folders
# Deutsch: Schließe Ordner für virtuelle Umgebungen aus
venv/
.venv/
env/
ENV/

# Build & Distribution
# English: Exclude PyInstaller build and distribution folders
# Deutsch: Schließe PyInstaller Build- und Dist-Ordner aus
build/
dist/
*.spec

# Windows
# English: Exclude Windows system files
# Deutsch: Schließe Windows-Systemdateien aus
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# Meta
# English: Ignore the gitignore file itself
# Deutsch: Ignoriere die gitignore-Datei selbst
.gitignore

# English: Ignore Gemini CLI project-specific settings
# Deutsch: Ignoriere Gemini CLI projektspezifische Einstellungen
gemini.md

# Project Documentation
# English: Ignore project-specific documentation files
# Deutsch: Ignoriere projektspezifische Dokumentationsdateien
Pflichtenheft.md
Project_Status.md

# Gemini Plans
# English: Ignore archived Gemini CLI plans
# Deutsch: Ignoriere archivierte Gemini CLI Pläne
done_plans/

# Legacy/Unused
# English: Ignore unused or legacy code
# Deutsch: Ignoriere ungenutzten oder alten Code
not_used/
