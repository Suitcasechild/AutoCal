        <property name="toolTip">
         <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;&lt;span style=&quot; font-weight:700;&quot;&gt;Anzahl der Laststufen&lt;/span&gt;&lt;/p&gt;&lt;p&gt;Bestimmt die Anzahl der Stützpunkte für die Kalibrierung. &lt;br/&gt;Hinweis:&lt;br/&gt;Werte &amp;gt; 2 erhöhen die Genauigkeit der Berechnung signifikant.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
        </property>
       </widget>
      </item>
      <item row="1" column="0">
